    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.16.3",
    "pg-boss": "^10.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.1.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "prisma": "^6.19.3"
  },
  "allowScripts": {
