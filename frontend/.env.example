NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_META_PIXEL_ID=1645715973642563
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=923002026711
# Optional extra next/image hosts (comma-separated), e.g. a custom R2 domain like cdn.zelvomart.com
NEXT_PUBLIC_IMAGE_HOSTS=

# Must match backend REVALIDATION_SECRET
REVALIDATION_SECRET=replace-with-a-long-random-secret
# Optional: if set, match this with the backend. Otherwise the proxy reuses REVALIDATION_SECRET.
STORE_PROXY_SECRET=

# Privacy-masked customer journey replays (set false to disable)
NEXT_PUBLIC_SESSION_REPLAY_ENABLED=true

# Local development fallback is http://localhost:4000, but set these explicitly in production.

# IMPORTANT: BACKEND_URL must be the deployed Express backend origin, not the frontend/Vercel storefront URL.
# Browser tracking and session replay use same-origin proxy routes so public API calls do not 404 when NEXT_PUBLIC_API_URL is unavailable client-side.
