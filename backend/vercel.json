{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": [
        "src/generated/prisma/**",
        "prisma/schema.prisma"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ]
}
