generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  ON_HOLD
  BOOKED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
  SETTLED
}

enum PaymentMethod {
  COD
  NAYAPAY
}

enum Role {
  OWNER
  MANAGER
  ORDER_AGENT
  MARKETER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  ENDED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Category {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?   @db.Text
  imageUrl        String?
  sortOrder       Int       @default(0)
  seoTitle        String?
  seoDescription String?    @db.Text
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sortOrder])
}

model Product {
  id                    String        @id @default(cuid())
  title                 String
  slug                  String        @unique
  sku                   String        @unique
  shortDescription      String?       @db.Text
  descriptionHtml       String?       @db.Text
  images                Json          @default("[]")
  videoUrl              String?
  categoryId            String?
  category              Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price                 Decimal       @db.Decimal(12, 2)
  salePrice             Decimal?      @db.Decimal(12, 2)
  costPrice             Decimal?      @db.Decimal(12, 2)
  stock                 Int           @default(0)
  status                ProductStatus @default(DRAFT)
  featured              Boolean       @default(false)
  bundleEnabled         Boolean       @default(true)
  bundleDiscountPercent Decimal?      @db.Decimal(5, 2)
  seoTitle              String?
  seoDescription        String?       @db.Text
  canonicalUrl          String?
  sourceUrl             String?
  sourceId              String?
  variants              Variant[]
  orderItems            OrderItem[]
  reviews               Review[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, featured, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model Variant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String   @unique
  name          String
  attributes    Json
  priceOverride Decimal? @db.Decimal(12, 2)
  stock         Int      @default(0)
  imageUrl      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@index([productId, active])
}

model Customer {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String?
  email       String?
  refusalCount Int     @default(0)
  blocklisted Boolean  @default(false)
  notes       String?  @db.Text
  orders      Order[]
  reviews     Review[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  idempotencyKey    String        @unique
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  fullName          String
  phone             String
  email             String?
  city              String
  address           String        @db.Text
  postcode          String?
  notes             String?       @db.Text
  status            OrderStatus   @default(NEW)
  paymentMethod     PaymentMethod @default(COD)
  subtotal          Decimal       @db.Decimal(12, 2)
  bundleSaving      Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee       Decimal       @default(0) @db.Decimal(12, 2)
  codFee            Decimal       @default(0) @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  source             String?
  firstTouch         Json?
  lastTouch          Json?
  fbp                String?
  fbc                String?
  clarityId          String?
  replaySessionId    String?
  clientIp           String?
  clientUserAgent    String? @db.Text
  experiments        Json?
  possibleDuplicate Boolean       @default(false)
  blocklistedAtOrder Boolean       @default(false)
  test               Boolean       @default(false)
  staffCreated       Boolean       @default(false)
  postexTracking     String?
  postexStatus       String?
  settlementRef      String?
  settledAt          DateTime?
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  events             EventLog[]
  reviews            Review[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([phone, createdAt])
  @@index([city])
  @@index([source])
  @@index([replaySessionId])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId          String?
  sku                String
  title              String
  variantLabel       String?
  quantity           Int
  unitPrice          Decimal  @db.Decimal(12, 2)
  lineTotal          Decimal  @db.Decimal(12, 2)
  bundleDiscount     Decimal  @default(0) @db.Decimal(12, 2)
  imageUrl           String?

  @@index([orderId])
  @@index([sku])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  note      String?     @db.Text
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model EventLog {
  id           String   @id @default(cuid())
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  eventName    String
  eventId      String
  sessionReplayId String?
  channel      String
  sourceUrl    String?
  payload      Json
  response     Json?
  accepted     Boolean?
  error        String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([eventId])
  @@index([orderId])
  @@index([sessionReplayId, createdAt])
}

model SessionReplay {
  id          String   @id
  visitorId   String
  source      String   @default("direct")
  medium      String?
  campaign    String?
  landingUrl  String   @db.Text
  lastUrl     String   @db.Text
  referrer    String?  @db.Text
  device      String?
  viewport    String?
  status      String   @default("ACTIVE")
  startedAt   DateTime
  lastSeenAt  DateTime
  endedAt     DateTime?
  eventCount  Int      @default(0)
  chunkCount  Int      @default(0)
  pageViews   Int      @default(1)
  metadata    Json?
  chunks      SessionReplayChunk[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startedAt])
  @@index([source, startedAt])
  @@index([status, lastSeenAt])
  @@index([visitorId, startedAt])
}

model SessionReplayChunk {
  id         String        @id @default(cuid())
  sessionId  String
  session    SessionReplay @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence   Int
  events     Json
  eventCount Int
  createdAt  DateTime      @default(now())

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
}

model Job {
  id          String    @id @default(cuid())
  name        String
  externalId  String?
  orderId     String?
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  error       String?   @db.Text
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([name, createdAt])
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  bodyHtml        String   @db.Text
  seoTitle        String?
  seoDescription String?   @db.Text
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  passwordHash   String
  role           Role                 @default(ORDER_AGENT)
  totpSecret     String?
  twoFactorReady Boolean              @default(false)
  active         Boolean              @default(true)
  statusChanges  OrderStatusHistory[]
  auditLogs      AuditLog[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}


model StoreUser {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  active       Boolean        @default(true)
  sessions     StoreSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model StoreSession {
  id         String    @id @default(cuid())
  userId     String
  user       StoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Experiment {
  id           String           @id @default(cuid())
  name         String
  pagePattern  String
  variants     Json
  trafficSplit Json
  status       ExperimentStatus @default(DRAFT)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name       String
  rating     Int
  body       String       @db.Text
  images     Json         @default("[]")
  verified   Boolean      @default(false)
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([productId, status, createdAt])
}

model AbandonedCheckout {
  id            String   @id @default(cuid())
  phone         String
  fullName      String?
  email         String?
  city          String?
  address       String?
  cart          Json
  source        Json?
  followedUpAt  DateTime?
  convertedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone, createdAt])
  @@index([followedUpAt, convertedAt, createdAt])
}

model City {
  id               String   @id @default(cuid())
  name             String   @unique
  postexCode       String?
  deliveryMinDays  Int      @default(2)
  deliveryMaxDays  Int      @default(5)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, name])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String   @unique
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

model Sequence {
  name  String @id
  value Int    @default(10000)
}

model Redirect {
  id          String   @id @default(cuid())
  sourcePath  String   @unique
  destination String
  permanent   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
