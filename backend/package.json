{
  "name": "@zelvomart/backend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/server.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json && node scripts/upload-sourcemaps.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/*.test.ts\"",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:health": "tsx scripts/db-health.ts",
    "db:env-check": "node scripts/validate-supabase-env.mjs",
    "worker": "tsx workers/main.ts",
    "migrate:wordpress": "tsx scripts/migrate-wordpress.ts",
    "templates": "tsx scripts/generate-import-templates.ts",
    "stock:backfill": "tsx scripts/backfill-stock-columns.ts",
    "qa:urls": "tsx scripts/check-urls.ts",
    "migrate:urls": "tsx scripts/migration/export-wordpress-urls.ts",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "setup": "prisma generate --schema=prisma/schema.prisma && prisma db push --schema=prisma/schema.prisma",
    "test:reviews": "node --import tsx --test src/lib/review-import.test.ts",
    "test:reviews:integration": "node --import tsx scripts/review-system.integration.mts",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.890.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.8.0",
    "@vercel/functions": "^2.2.13",
    "@zelvomart/monitoring": "1.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pg-boss": "^10.3.2",
    "qrcode": "^1.5.4",
    "resend": "^6.1.0",
    "sanitize-html": "2.17.4",
    "sharp": "^0.35.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@sentry/cli": "^3.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
