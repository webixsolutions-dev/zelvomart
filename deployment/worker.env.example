# Copy to backend/.env.worker ON THE SERVER. Do not commit the populated file.
DATABASE_URL=postgresql://USER:PASSWORD@SESSION_OR_DIRECT_HOST:5432/postgres?sslmode=require
WORKER_DATABASE_URL=postgresql://USER:PASSWORD@SESSION_OR_DIRECT_HOST:5432/postgres?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@SESSION_OR_DIRECT_HOST:5432/postgres?sslmode=require
# Set true only AFTER running the backlog preview and reviewing recent sends.
WORKER_BACKLOG_REVIEWED=false
NEXT_PUBLIC_SITE_URL=https://zelvomart.vercel.app
JWT_SECRET=USE_THE_EXISTING_BACKEND_SECRET
RESEND_API_KEY=USE_THE_EXISTING_BACKEND_VALUE
EMAIL_FROM=USE_THE_EXISTING_BACKEND_VALUE
# Other existing email/alert environment variables must match the backend.
# Meta/TikTok credentials are read from saved admin Settings (environment fallback supported).
